# ============================================
# AgentEducator2 后端环境变量配置模板
# 复制本文件为 .env 并填写实际值
# cp .env.example .env
# ============================================

# === AI 模型配置 ===
# SiliconFlow API Key（用于大模型调用和 Embedding）
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here
# 火山引擎 API Key（可选，备用模型）
VOLCENGINE_API_KEY=your-volcengine-api-key-here

# === 数据库配置 (MySQL) ===
# 格式: mysql+pymysql://用户名:密码@地址:端口/数据库名
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:password@localhost:3306/agent_educator?charset=utf8mb4

# === Agent 智能模式 ===
AGENT_MODE_ENABLED=True

# === Neo4j 知识图谱（可选，不装系统也能启动） ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j

# === 腾讯云 OCR（可选，使用 PaddleOCR 时无需配置） ===
# TENCENT_OCR_SECRET_ID=your-tencent-secret-id
# TENCENT_OCR_SECRET_KEY=your-tencent-secret-key
