@startuml
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam EntityBackgroundColor #F8F8F8

entity "User (用户表)" as user {
  * id : INT <<PK>>
  --
  * username : VARCHAR(50) [UK]
  * password_hash : VARCHAR(255)
  role : ENUM('student', 'teacher')
  created_at : DATETIME
}

entity "Course (课程核心表)" as course {
  * id : INT <<PK>>
  --
  * title : VARCHAR(100)
  description : TEXT
  * creator_id : INT <<FK>>
}

entity "Video (多模态教学资源表)" as video {
  * id : INT <<PK>>
  --
  * course_id : INT <<FK>>
  * title : VARCHAR(100)
  * video_url : VARCHAR(255)
  parsed_text : TEXT [字幕流]
  vector_path : VARCHAR(255) [FAISS]
}

entity "ChatSession (问答会话表)" as session {
  * id : INT <<PK>>
  --
  * user_id : INT <<FK>>
  * context_title : VARCHAR(100)
  created_at : DATETIME
}

entity "Message (时序消息记录表)" as msg {
  * id : INT <<PK>>
  --
  * session_id : INT <<FK>>
  * content : TEXT
  role_type : ENUM('user', 'assistant')
  timestamp : DATETIME
}

entity "CodeTaskRecord (代码实训流转表)" as coderecord {
  * id : INT <<PK>>
  --
  * student_id : INT <<FK>>
  * task_id : INT
  * submit_code : TEXT
  syntax_score : FLOAT
  ai_feedback : TEXT [苏格拉底辅导]
}

' 明确 1 对多关联 (1 to N)，并用 UML 符号标识多重性结构
user "1" -- "0..*" course : 创建 >
course "1" -- "1..*" video : 分出小节 >

user "1" -- "0..*" session : 发起对话 >
session "1" -- "1..*" msg : 包含聊天记录 >

user "1" -- "0..*" coderecord : 提交实训记录 >

@enduml