@startuml
skinparam componentStyle rectangle

package "表现层 / 前端 UI (Vue 3)" {
  [Vue Router]
  [Pinia 状态管理]
  [视频播放组件]
  [代码编辑器沙箱]
  [Markdown 流式渲染]
}

package "业务服务层 / 后端 Flask" {
  [认证与用户服务]
  [课程与视频服务]
  [RAG 混合检索服务]
  [代码 AST 分析服务]
  [LLM 调度服务]
}

package "数据持久层" {
  database "MySQL (结构化数据)" {
    [用户信息/课程/日志]
  }
  database "Redis (缓存)" {
    [会话缓存]
  }
  database "FAISS (向量索引)" {
    [文档/字幕切片向量]
  }
}

package "基础设施层" {
  node "Nginx反向代理"
  node "Docker 容器"
}

[Vue Router] --> [认证与用户服务]
[视频播放组件] --> [课程与视频服务]
[视频播放组件] --> [RAG 混合检索服务]
[代码编辑器沙箱] --> [代码 AST 分析服务]
[Markdown 流式渲染] --> [LLM 调度服务]

[认证与用户服务] --> [用户信息/课程/日志]
[课程与视频服务] --> [用户信息/课程/日志]
[RAG 混合检索服务] --> [文档/字幕切片向量]
[RAG 混合检索服务] --> [会话缓存]
[LLM 调度服务] --> [会话缓存]

[业务服务层 / 后端 Flask] ..> [Nginx反向代理] : 部署于
[Nginx反向代理] ..> [Docker 容器] : 运行于
@enduml
