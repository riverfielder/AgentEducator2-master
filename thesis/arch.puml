@startuml
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam padding 10

package "表现层 / 前端富客户端环境 (Vue 3)" {
  [Markdown 流式渲染引擎]
  [代码动态沙盒视图 (Monaco或CodeMirror)]
  [HTML5 视频播放器 (时间轴联动)]
}

package "业务核心服务层 (AI 特化级 - Flask)" {
  [基础模块 (RESTful/认证/分发)]
  [LLM 调度中间件 (LangChain & 缓冲池)]
  
  [AST 代码分析引擎 (白盒探测/圈复杂度)]
  [RAG 混合检索引擎 (RRF重排/BM25)]
}

package "数据持久层 (多源多模态存储)" {
  database "MySQL (强一致性业务数据)\n[用户/课程/订单/实训]" as MySQL
  database "Redis (高速缓存/消息中心)\n[Session/状态机制]" as Redis
  database "FAISS (高维稠密向量存储)\n[字幕片段/教案向量]" as FAISS
}

package "基础设施层 (云端部署)" {
  node "Nginx反向代理 (动静分离/负载均衡)" as Nginx
  node "Docker 容器化群集引擎" as Docker
}

[表现层 / 前端富客户端环境 (Vue 3)] ..> [业务核心服务层 (AI 特化级 - Flask)] : HTTPS/REST, SSE
[Markdown 流式渲染引擎] --> [LLM 调度中间件 (LangChain & 缓冲池)]
[代码动态沙盒视图 (Monaco或CodeMirror)] --> [AST 代码分析引擎 (白盒探测/圈复杂度)]
[HTML5 视频播放器 (时间轴联动)] --> [RAG 混合检索引擎 (RRF重排/BM25)]

[业务核心服务层 (AI 特化级 - Flask)] --> MySQL
[业务核心服务层 (AI 特化级 - Flask)] --> Redis
[业务核心服务层 (AI 特化级 - Flask)] --> FAISS

Nginx ..> [业务核心服务层 (AI 特化级 - Flask)] : 代理转发
Docker ..> Nginx : 承载服务
Docker ..> [数据持久层 (多源多模态存储)] : 承载持久卷

@enduml